# Connection settings for the test suite (read by tests/settings.py).
# Copy to .env and fill in real values. Never commit .env.
#
# Use a dedicated, empty library for TEST_SYSTEM_SCHEMA: the tests create
# tables there and flush (DELETE FROM) every Django-managed table in it.

# IBM i host name or IP address
TEST_SYSTEM_HOST=your-ibmi-host

# IBM i user profile and password
TEST_SYSTEM_USERNAME=your-user
TEST_SYSTEM_PASSWORD=your-password

# Library (schema) the tests run against
TEST_SYSTEM_SCHEMA=DJANGOTEST
